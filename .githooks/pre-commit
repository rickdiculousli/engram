#!/bin/sh
# engram's own pre-commit; a clone turns it on once with `git config core.hooksPath .githooks`.
# No tracked .venv, no instance named in src/ (instance.py), the tests pass, and so do the packs this box pins (packs.py).
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ -n "$(git ls-files -- .venv)" ]; then
  echo "pre-commit: .venv is tracked; untrack it with: git rm -r --cached .venv" >&2
  exit 1
fi
uv run -q python .githooks/instance.py || exit 1
uv run -q pytest -q -x >/dev/null 2>&1 || { echo "pre-commit: the tests fail; run uv run pytest -q" >&2; exit 1; }
uv run -q python .githooks/packs.py || exit 1
